generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPERVISOR
  STAFF
  CLIENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PENDING
  ON_HOLD
  DISCHARGED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum PayType {
  HOURLY
  PER_VISIT
  SALARY
}

enum VisitStatus {
  VACANT
  SCHEDULED
  OFFERED
  IN_PROGRESS
  CLOCKED_IN
  COMPLETED
  APPROVED
  MISSED
  LATE
  CANCELLED
  ON_HOLD
  NO_SHOW
}

enum FormStatus {
  PENDING
  COMPLETED
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum MedAdministrationStatus {
  ADMINISTERED
  HELD
  REFUSED
  NOT_GIVEN
}

enum Frequency {
  DAILY
  WEEKLY
  BI_WEEKLY
  MONTHLY
  AS_NEEDED
  CUSTOM
}

enum InsuranceClaimStatus {
  PENDING
  SUBMITTED
  IN_REVIEW
  APPROVED
  DENIED
  APPEALED
  PAID
  VOIDED
}

// Models

model Organization {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  users         User[]
  clients       Client[]
  staff         Staff[]
  services      Service[]
  carePlans     CarePlan[]
  visits        Visit[]
  invoices      Invoice[]
  timesheets    Timesheet[]
  formTemplates FormTemplate[]
  insuranceClaims InsuranceClaim[]

  @@map("organization")
}

model Branch {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  status      Boolean  @default(true)
  organizationId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  clients      Client[]
  staff        Staff[]
  carePlans    CarePlan[]
  visits       Visit[]
  invoices     Invoice[]
  timesheets   Timesheet[]

  @@unique([organizationId, name])
  @@map("branch")
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  password       String
  firstName      String
  lastName       String
  role           UserRole   @default(STAFF)
  status         Boolean    @default(true)
  avatar         String?
  organizationId String
  branchId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  staff          Staff?
  client         Client?
  visits         Visit[]
  invoices       Invoice[]
  timesheets     Timesheet[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@unique([organizationId, email])
  @@map("user")
}

model Client {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String
  avatar         String?
  dateOfBirth    DateTime?
  gender         String?
  ssn            String?
  email          String?
  phone          String
  address        String
  city           String
  state          String
  zipCode        String
  status         ClientStatus @default(PENDING)
  insuranceType  String?
  insuranceId    String?
  organizationId String
  branchId       String?
  userId         String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user           User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  carePlans      CarePlan[]
  visits         Visit[]
  forms          ClientForm[]
  invoices       Invoice[]
  emergencyContacts EmergencyContact[]
  medications    Medication[]
  medicalHistory MedicalHistory[]
  medicalInfo    ClientMedicalInfo?
  documents      Document[]
  insuranceClaims InsuranceClaim[]

  @@index([organizationId, status])
  @@index([organizationId, branchId])
  @@unique([organizationId, email])
  @@map("client")
}

// ─── DOCUMENT MANAGEMENT ───────────────────────────────

model Document {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  type        String
  url         String
  size        Int?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@map("document")
}

model ClientMedicalInfo {
  id               String   @id @default(uuid())
  clientId         String   @unique
  allergies        String?
  conditions       String?
  height           Float?
  weight           Float?
  bloodType        String?
  primaryPhysician String?
  physicianPhone   String?
  functionalLevel  String?
  mobilityAid      String?
  cognitiveStatus  String?
  skinCondition    String?
  dietRestrictions String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_medical_info")
}

model Staff {
  id             String       @id @default(uuid())
  employeeId     String       @unique
  firstName      String
  lastName       String
  email          String       @unique
  phone          String
  role           String
  payType        PayType      @default(HOURLY)
  hourlyRate     Float?
  status         StaffStatus  @default(INACTIVE)
  licenseNumber  String?
  licenseExpiry  DateTime?
  hireDate       DateTime?
  organizationId String
  branchId       String?
  userId         String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user           User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  carePlans      CarePlan[]
  visits         Visit[]
  timesheets     Timesheet[]
  skills         StaffSkill[]
  certifications StaffCertification[]
  availability   StaffAvailability[]
  medAdministrations MedAdministration[]

  @@index([organizationId, status])
  @@index([organizationId, branchId])
  @@map("staff")
}

model Service {
  id             String            @id @default(uuid())
  name           String
  description    String?
  duration       Int?
  baseRate       Float
  status         Boolean           @default(true)
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  carePlans        CarePlan[]
  carePlanServices CarePlanService[]
  visitServices    Visit[]
  invoiceItems     InvoiceItem[]

  @@unique([organizationId, name])
  @@map("service")
}

model CarePlan {
  id             String   @id @default(uuid())
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  status         Boolean  @default(true)
  organizationId String
  branchId       String?
  clientId       String
  staffId        String?
  serviceId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staff        Staff?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  service      Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  visits       Visit[]
  services     CarePlanService[]

  @@index([organizationId, clientId])
  @@unique([organizationId, name])
  @@map("care_plan")
}

model CarePlanService {
  id           String   @id @default(uuid())
  carePlanId   String
  serviceId    String
  frequency    Frequency @default(AS_NEEDED)
  frequencyText String?
  instructions String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  carePlan CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade, map: "care_plan_service_fk")
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Restrict, map: "care_plan_service_service_fk")

  @@unique([carePlanId, serviceId])
  @@map("care_plan_service")
}

model Visit {
  id             String       @id @default(uuid())
  title          String?
  description    String?
  startTime      DateTime
  endTime        DateTime
  status         VisitStatus  @default(SCHEDULED)
  actualStart    DateTime?
  actualEnd      DateTime?
  notes          String?
  organizationId String
  branchId       String?
  carePlanId     String?
  serviceId      String?
  clientId       String
  staffId        String?
  userId         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  carePlan     CarePlan?    @relation(fields: [carePlanId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  staff        Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitTasks       VisitTask[]
  visitNotes       VisitNote[]
  invoices         Invoice[]
  invoiceItems     InvoiceItem[]
  forms            ClientForm[]
  medAdministrations MedAdministration[]
  timesheetEntries TimesheetEntry[]

  @@index([organizationId, startTime])
  @@index([staffId, startTime, status])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, staffId])
  @@index([clientId, status])
  @@map("visit")
}

model Invoice {
  id             String         @id @default(uuid())
  invoiceNumber  String         @unique
  amount         Float
  status         InvoiceStatus  @default(DRAFT)
  dueDate        DateTime
  paidDate       DateTime?
  notes          String?
  organizationId String
  branchId       String?
  clientId       String
  userId         String?
  visitId        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  visit        Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  invoiceItems    InvoiceItem[]
  payments        Payment[]
  insuranceClaims InsuranceClaim[]

  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@unique([organizationId, invoiceNumber])
  @@map("invoice")
}

model InsuranceClaim {
  id                String               @id @default(uuid())
  claimNumber       String               @unique
  invoiceId         String
  clientId          String
  insuranceType     String
  insuranceId       String
  diagnosisCode     String?
  authorizationNumber String?
  serviceDate       DateTime
  amount            Float
  approvedAmount    Float?
  status            InsuranceClaimStatus @default(PENDING)
  submittedDate     DateTime?
  responseDate      DateTime?
  denialReason      String?
  notes             String?
  organizationId    String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, claimNumber])
  @@map("insurance_claim")
}

model Timesheet {
  id             String          @id @default(uuid())
  startDate      DateTime
  endDate        DateTime
  totalHours     Float
  status         TimesheetStatus @default(DRAFT)
  notes          String?
  organizationId String
  branchId       String?
  staffId        String
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  timesheetEntries TimesheetEntry[]

  @@index([organizationId, staffId])
  @@index([organizationId, status])
  @@map("timesheet")
}

// Supporting Models

model EmergencyContact {
  id        String   @id @default(uuid())
  name      String
  relation  String
  phone     String
  email     String?
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("emergency_contact")
}

model Medication {
  id                 String                   @id @default(uuid())
  name               String
  dosage             String
  frequency          String
  route              String?
  administrationType String?
  administrationTiming String?
  status             String?
  startDate          DateTime?
  endDate            DateTime?
  notes              String?
  clientId           String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  client               Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  medAdministrations   MedAdministration[]

  @@map("medication")
}

model MedAdministration {
  id             String                   @id @default(uuid())
  medicationId   String
  visitId        String?
  staffId        String
  administeredAt DateTime
  status         MedAdministrationStatus  @default(ADMINISTERED)
  dosage         String?
  unit           String?
  reason         String?
  comment        String?
  createdAt      DateTime                 @default(now())

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  visit      Visit?     @relation(fields: [visitId], references: [id], onDelete: SetNull)
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@map("med_administration")
}

model MedicalHistory {
  id        String   @id @default(uuid())
  condition String
  diagnosis String?
  date      DateTime?
  notes     String?
  clientId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("medical_history")
}

model FormTemplate {
  id             String   @id @default(uuid())
  name           String
  description    String?
  schema         Json
  category       String?
  isRequired     Boolean  @default(false)
  status         Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientForms  ClientForm[]

  @@unique([organizationId, name])
  @@map("form_template")
}

model ClientForm {
  id              String      @id @default(uuid())
  templateId      String
  visitId         String?
  clientId        String
  formData        Json?
  status          FormStatus  @default(PENDING)
  submittedAt     DateTime?
  submittedBy     String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  visit    Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_form")
}

model StaffSkill {
  id        String   @id @default(uuid())
  name      String
  level     String?
  staffId   String
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, name])
  @@map("staff_skill")
}

model StaffCertification {
  id        String   @id @default(uuid())
  name      String
  number    String?
  issuedBy  String
  issueDate DateTime
  expiryDate DateTime?
  staffId   String
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_certification")
}

model StaffAvailability {
  id        String   @id @default(uuid())
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, etc.
  startTime String
  endTime   String
  isAvailable Boolean @default(true)
  staffId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("staff_availability")
}

model InvoiceItem {
  id          String @id @default(uuid())
  description String
  quantity    Int    @default(1)
  unitPrice   Float
  amount      Float
  invoiceId   String
  visitId     String?
  serviceId   String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  visit   Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("invoice_item")
}

model Payment {
  id              String   @id @default(uuid())
  invoiceId       String
  amount          Float
  paymentMethod   String
  paymentDate     DateTime
  referenceNumber String?
  notes           String?
  createdAt       DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("payment")
}

model TimesheetEntry {
  id            String   @id @default(uuid())
  date          DateTime
  hours         Float
  notes         String?
  billable      Boolean  @default(true)
  timesheetId   String
  visitId       String?
  createdAt     DateTime @default(now())

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  visit     Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@map("timesheet_entry")
}

model VisitTask {
  id        String   @id @default(uuid())
  title     String
  category  String?
  completed Boolean  @default(false)
  notes     String?
  visitId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("visit_task")
}

model VisitNote {
  id        String   @id @default(uuid())
  content   String
  visitId   String
  createdAt DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("visit_note")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  userId    String
  changes   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("audit_log")
}
